{
  "name": "usfl-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.js --dev",
    "check": "node --disable-warning=ExperimentalWarning scripts/check-config.mjs",
    "build": "node --disable-warning=ExperimentalWarning scripts/check-config.mjs && vite build",
    "build:static": "node --disable-warning=ExperimentalWarning scripts/check-config.mjs && VITE_HASH=1 vite build --outDir dist-static",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "user:create": "node --disable-warning=ExperimentalWarning server/cli.js user:create",
    "user:reset": "node --disable-warning=ExperimentalWarning server/cli.js user:reset",
    "content:export": "node --disable-warning=ExperimentalWarning server/cli.js content:export",
    "content:import": "node --disable-warning=ExperimentalWarning server/cli.js content:import",
    "test": "node --disable-warning=ExperimentalWarning scripts/test-cms.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "description": "The USFL website — an editable, config-driven React + GSAP site.",
  "engines": {
    "node": ">=22.13"
  }
}
