# Copy to .env and fill in. Never commit .env — it can contain a password.

# First start only: creates the owner account if there are no accounts yet.
# Remove ADMIN_PASSWORD from the file after the first sign-in (the password is stored hashed in the database).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the database, uploads and version history are stored. Must be persistent and backed up.
DATA_DIR=./data

# Port the server listens on (3000 in production, 5173 for `npm run dev`).
PORT=3000

# The public address of the site, used for canonical links, the sitemap and link previews.
SITE_ORIGIN=https://usfl.co.za

# Set to 1 when the server runs behind a proxy or load balancer that terminates HTTPS (most hosts do).
TRUST_PROXY=1

# Optional: also send every contact-form message to this address (e.g. a Zapier, Make or Formspree webhook).
FORM_WEBHOOK_URL=

# Only for local testing over plain http in production mode. Never set this on the live site.
INSECURE_COOKIES=
